# Example environment variables for production deployment (do NOT commit secrets to VCS)
# Copy this file to .env.prod and set real values in your deployment environment or secrets manager.

# Database
DB_URL=jdbc:mysql://prod-db-host:3306/seckill?useSSL=false&serverTimezone=UTC&characterEncoding=utf8mb4
DB_USER=seckill
DB_PASSWORD=changeme_super_secret

# Redis
REDIS_HOST=prod-redis-host
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP=prod-kafka-1:9092,prod-kafka-2:9092

# Nacos
NACOS_SERVER_ADDR=prod-nacos:8848
NACOS_NAMESPACE=

# Service ports
PRODUCT_PORT=8081
ORDER_PORT=8082

# Logging
LOG_LEVEL=INFO
